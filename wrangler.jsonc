{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pesat-ai-homepage",
  "account_id": "99dd60debc042e9b615dd44472645e71",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-30",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Use a model your OpenAI key actually has + that supports Responses API + structured output.
    // (Was "gpt-5.5" which likely 404s -> AI silently falls back. Change back if you have it.)
    "OPENAI_MODEL": "gpt-4.1",
    "NEXT_PUBLIC_SITE_URL": "https://pesat.ai"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": true
  // Custom domain attaches only AFTER the `pesat.ai` zone exists in Cloudflare.
  // First deploy goes to *.workers.dev. To bind the domain later, re-enable:
  // "routes": [
  //   { "pattern": "pesat.ai", "custom_domain": true },
  //   { "pattern": "www.pesat.ai", "custom_domain": true }
  // ]
}
